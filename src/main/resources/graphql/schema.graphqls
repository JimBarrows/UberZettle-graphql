interface Node {
    """The ID of the object, which must be globally unique."""
    id: ID!
}

type Idea implements Node {
    id: ID!
    idea: String!
}

input IdeaCreateInput{
    idea: String!
}

type Mutation {
    ideaCreate( newIdea: IdeaCreateInput): Idea
}
type Query {
    """Fetches an object given its global ID."""
    node(id: ID!): Node
}
